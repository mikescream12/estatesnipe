TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# From number in E.164. Leave empty to fail closed. Do not paste a retired number.
TWILIO_PHONE_NUMBER=
# Set to 1 after Twilio upgrade to send custom match SMS bodies
TWILIO_ALLOW_CUSTOM_BODY=

# Vercel cron auth for GET /api/watch/cron
CRON_SECRET=
CRON_ZIP=75201
CRON_RADIUS_MILES=25
CRON_WATCH_TEXTS=sterling|hen on a nest|pokemon|mcm
CRON_NOTIFY_PHONE=
# Cron skips OpenAI vision by default (Hobby 60s). Set 1 to opt in.
CRON_ENABLE_VISION=

# Optional: probe Facebook Marketplace public URL (usually blocked)
FB_MARKETPLACE_PROBE=

# Optional overrides
ESTATESNIPE_CACHE_DIR=/tmp/estatesnipe-cache
ESTATESNIPE_STORE_FILE=/tmp/estatesnipe-store.json

# Vision / premium photo matching
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o
# XAI_API_KEY=
ESTATESNIPE_VISION_ENABLED=false
ESTATESNIPE_PREMIUM_VISION=true
ESTATESNIPE_VISION_MIN_CONFIDENCE=0.72
ESTATESNIPE_VISION_MAX_LISTINGS=25
ESTATESNIPE_VISION_MAX_PHOTOS=6
ESTATESNIPE_VISION_CONCURRENCY=3
ESTATESNIPE_VISION_TIMEOUT_MS=25000
ESTATESNIPE_VISION_CACHE_DIR=/tmp/estatesnipe-vision-cache

# Stripe Checkout. Hosted Checkout needs the secret key on the server.
# STRIPE_PRICE_ID is optional. Empty uses inline $9/month (chosen default).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PUBLISHABLE_KEY=
