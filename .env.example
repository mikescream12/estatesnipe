TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+17372583742
# Set to 1 after Twilio upgrade to send custom match SMS bodies
TWILIO_ALLOW_CUSTOM_BODY=

# Vercel cron auth for GET /api/watch/cron
CRON_SECRET=
CRON_ZIP=75201
CRON_RADIUS_MILES=25
CRON_WATCH_TEXTS=sterling|hen on a nest|pokemon|mcm
CRON_NOTIFY_PHONE=

# Optional: probe Facebook Marketplace public URL (usually blocked)
FB_MARKETPLACE_PROBE=

# Optional overrides
ESTATESNIPE_CACHE_DIR=/tmp/estatesnipe-cache
ESTATESNIPE_STORE_FILE=/tmp/estatesnipe-store.json
